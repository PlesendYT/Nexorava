# Nexorava Configuration
# Copy this to .env and fill in your values
# NEVER commit .env to git!

# Session secret (change this!)
SESSION_SECRET=nexorava-session-secret-change-in-production

# Email verification (optional, requires nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=Nexorava <noreply@nexorava.com>
