<%
const avatarUrl = user.avatar ? '/uploads/' + user.avatar : 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22%3E%3Ccircle cx=%2250%22 cy=%2250%22 r=%2250%22 fill=%22%231db954%22/%3E%3Ctext x=%2250%22 y=%2265%22 text-anchor=%22middle%22 font-size=%2250%22 fill=%22white%22%3E' + (user ? user.username[0].toUpperCase() : '?') + '%3C/text%3E%3C/svg%3E';
const csrfVal = csrfToken;
const sList = songs.length ? songs.map(s => songItem(s, '<span>' + fmtDate(s.uploaded_at) + '</span><form method="POST" action="/song/' + s.id + '/delete" style="display:inline" onsubmit="return confirm(\'Delete?\')"><input type="hidden" name="_csrf" value="' + csrfVal + '"><button type="submit" class="btn btn-sm btn-danger">Delete</button></form>', user, albums, playlists)).join('') : '<div class="empty-state"><div class="empty-icon">🎵</div><p>No songs yet.</p></div>';
%>
<div class="profile-page">
  <% if (success) { %><div class="alert alert-success"><%= escapeHtml(success) %></div><% } %>
  
  <div class="profile-header">
    <div class="profile-avatar-wrapper">
      <img src="<%= escapeHtml(avatarUrl) %>" alt="Avatar" class="profile-avatar">
    </div>
    <div class="profile-info">
      <h1><%- helpers.userBadge(user) %></h1>
      <% if (user.bio) { %><p class="profile-bio"><%= escapeHtml(user.bio) %></p><% } %>
      <p class="text-muted">
        Member since <%= fmtDate(user.created_at) %> · 
        <%= songs.length %> songs · 
        <%= followerCount || 0 %> followers · 
        <%= followingCount || 0 %> following ·
        🪙 <%= user.coins || 0 %> coins
      </p>
      <div class="profile-badges">
        <% if (isPremium(user)) { %><span class="badge badge-premium badge-lg"><%- config.premium.badge %> PREMIUM</span><% } %>
        <% if (isVerified(user)) { %><span class="badge badge-verified badge-lg"><%- config.verified.badge %> VERIFIED</span><% } %>
      </div>
      <% if (!user.is_guest) { %><a href="/settings" class="btn btn-sm" style="margin-top:8px">Edit Profile</a><% } %>
    </div>
  </div>

  <div class="section">
    <div class="section-header">
      <h2>Your Songs</h2>
      <a href="/upload" class="btn btn-primary">+ Upload Music</a>
    </div>
    <div class="song-list"><%- sList %></div>
  </div>

  <div class="section">
    <div class="section-header">
      <h2>Albums</h2>
      <% if (songs.length) { %>
      <form method="POST" action="/album/create" class="inline-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="text" name="title" placeholder="Album title" class="form-input" required>
        <button class="btn btn-sm btn-primary">Create</button>
      </form>
      <% } %>
    </div>
    <div class="mini-grid">
      <% if (albums.length) { %>
        <% albums.forEach(a => { %>
        <div class="mini-card card-glass">
          <div class="mini-card-body">
            <strong><%= escapeHtml(a.title) %></strong>
            <% const albumCount = albumSongCounts && albumSongCounts[a.id] ? albumSongCounts[a.id] : 0; %>
            <small><%= albumCount %> songs</small>
            <span class="<%= a.is_public ? 'badge badge-success' : 'badge' %>"><%= a.is_public ? 'Public' : 'Private' %></span>
          </div>
          <div class="mini-card-actions">
            <form method="POST" action="/album/<%= a.id %>/toggle" style="display:inline">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-sm"><%= a.is_public ? 'Unpublish' : 'Publish' %></button>
            </form>
            <form method="POST" action="/album/<%= a.id %>/delete" style="display:inline" onsubmit="return confirm('Delete album?')">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-sm btn-danger">Delete</button>
            </form>
          </div>
        </div>
        <% }) %>
      <% } else { %>
        <div class="empty-state"><p>No albums yet.</p></div>
      <% } %>
    </div>
  </div>

  <div class="section">
    <div class="section-header">
      <h2>Playlists</h2>
      <% if (songs.length) { %>
      <form method="POST" action="/playlist/create" class="inline-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="text" name="title" placeholder="Playlist title" class="form-input" required>
        <button class="btn btn-sm btn-primary">Create</button>
      </form>
      <% } %>
    </div>
    <div class="mini-grid">
      <% if (playlists.length) { %>
        <% playlists.forEach(p => { %>
        <div class="mini-card card-glass">
          <div class="mini-card-body">
            <strong><%= escapeHtml(p.title) %></strong>
            <% const plCount = playlistSongCounts && playlistSongCounts[p.id] ? playlistSongCounts[p.id] : 0; %>
            <small><%= plCount %> songs</small>
            <span class="<%= p.is_public ? 'badge badge-success' : 'badge' %>"><%= p.is_public ? 'Public' : 'Private' %></span>
          </div>
          <div class="mini-card-actions">
            <form method="POST" action="/playlist/<%= p.id %>/toggle" style="display:inline">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-sm"><%= p.is_public ? 'Unpublish' : 'Publish' %></button>
            </form>
            <form method="POST" action="/playlist/<%= p.id %>/delete" style="display:inline" onsubmit="return confirm('Delete playlist?')">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-sm btn-danger">Delete</button>
            </form>
          </div>
        </div>
        <% }) %>
      <% } else { %>
        <div class="empty-state"><p>No playlists yet.</p></div>
      <% } %>
    </div>
  </div>
</div>
