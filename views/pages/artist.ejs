<%
const sList = songs.length ? songs.map(s => songItem(s, '', user)).join('') : '<div class="empty-state"><div class="empty-icon">🎵</div><p>No songs uploaded yet.</p></div>';
const isOwner = user && user.id == artist.id;
const avatarUrl = artist.avatar ? '/uploads/' + artist.avatar : 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22%3E%3Ccircle cx=%2250%22 cy=%2250%22 r=%2250%22 fill=%22%231db954%22/%3E%3Ctext x=%2250%22 y=%2265%22 text-anchor=%22middle%22 font-size=%2250%22 fill=%22white%22%3E' + (artist.username ? artist.username[0].toUpperCase() : '?') + '%3C/text%3E%3C/svg%3E';
%>
<div class="profile-page">
  <div class="profile-header">
    <div class="profile-avatar-wrapper">
      <img src="<%= escapeHtml(avatarUrl) %>" alt="Avatar" class="profile-avatar">
    </div>
    <div class="profile-info">
      <h1><%- helpers.userBadge(artist) %></h1>
      <p class="text-muted">
        Member since <%= fmtDate(artist.created_at) %> · 
        <%= songs.length %> songs · 
        <%= followerCount %> followers
        <span class="artist-id-tooltip" data-artist-id="<%= artist.id %>"></span>
      </p>
      <div class="profile-actions">
        <% if (!isOwner && user) { %>
        <button class="btn btn-sm follow-btn" data-id="<%= artist.id %>" data-following="<%= following %>"><%= following ? 'Unfollow' : 'Follow' %></button>
        <div class="dropdown" style="display:inline-block">
          <button class="btn btn-sm" onclick="event.stopPropagation();this.parentElement.classList.toggle('open')">Send Tip</button>
          <div class="dropdown-menu tip-form" style="padding:16px;min-width:220px;">
            <form onsubmit="sendTip(event, <%= artist.id %>)">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="form-group">
                <label>Amount (coins)</label>
                <input type="number" name="amount" min="1" value="5" class="form-input" required>
              </div>
              <div class="form-group">
                <label>Message</label>
                <textarea name="message" rows="2" class="form-input" maxlength="200"></textarea>
              </div>
              <button type="submit" class="btn btn-primary btn-block">Send</button>
            </form>
          </div>
        </div>
        <% } %>
      </div>
    </div>
  </div>
  <div class="section">
    <div class="section-header"><h2>Songs by <%= escapeHtml(artist.username) %></h2></div>
    <div class="song-list"><%- sList %></div>
  </div>
</div>
