<div class="section">
  <div class="section-header">
    <h1>Public Albums</h1>
  </div>
  <div class="mini-grid">
    <% if (albums.length) { %>
      <% albums.forEach(a => { %>
      <a href="/album/<%= a.id %>" class="mini-card card-glass" style="text-decoration:none;color:inherit">
        <div class="mini-card-icon">💿</div>
        <div class="mini-card-body">
          <strong><%= escapeHtml(a.title) %></strong>
          <small><%= escapeHtml(a.owner_name) %> · <%= a.song_count %> songs</small>
        </div>
      </a>
      <% }) %>
    <% } else { %>
      <div class="empty-state"><p>No public albums yet.</p></div>
    <% } %>
  </div>
</div>
