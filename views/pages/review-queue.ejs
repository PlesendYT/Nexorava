<% const { escapeHtml, fmtDate, isAdmin } = helpers; %>
<div class="section">
  <div class="section-header">
    <h1>Review Queue</h1>
    <% if (!isAdmin(user)) { %><p class="text-muted">Your reported content and review history.</p><% } %>
  </div>
  <% if (!reviews || reviews.length === 0) { %>
    <div class="empty-state"><p>No reviews found.</p></div>
  <% } else { %>
    <div class="table-responsive">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Type</th>
            <th>Target</th>
            <th>Reason</th>
            <th>Status</th>
            <th>Date</th>
          </tr>
        </thead>
        <tbody>
          <% reviews.forEach(r => { %>
            <tr>
              <td><%= escapeHtml(r.target_type) %></td>
              <td><%= escapeHtml(r.song_title || '#' + r.target_id) %></td>
              <td><%= escapeHtml(r.reason) %></td>
              <td><span class="badge <%= r.status === 'approved' ? 'badge-success' : r.status === 'rejected' ? 'badge-error' : 'badge-pending' %>"><%= escapeHtml(r.status) %></span></td>
              <td><%= fmtDate(r.created_at) %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
