<% const { escapeHtml, fmtDate, songItem } = helpers; %>
<div class="container">
  <h1>Recently Played</h1>
  <p class="text-muted">Your listening history.</p>

  <% if (!groupedHistory || Object.keys(groupedHistory).length === 0) { %>
    <p class="empty-state">No listening history yet. Start playing songs to build your history.</p>
  <% } else { %>
    <% Object.keys(groupedHistory).sort().reverse().forEach(date => { %>
      <div class="admin-section" style="padding:16px 20px">
        <h2 style="font-size:1.1rem;border-bottom:none;padding-bottom:0;margin-bottom:12px"><%= date === new Date().toISOString().split('T')[0] ? 'Today' : date === new Date(Date.now() - 86400000).toISOString().split('T')[0] ? 'Yesterday' : fmtDate(date) %></h2>
        <div class="song-list">
          <% groupedHistory[date].forEach(s => { %>
            <%- songItem(s, '<small style="color:var(--text3)">' + (s.played_at ? new Date(s.played_at).toLocaleTimeString('en-US', {hour:'numeric',minute:'2-digit'}) : '') + '</small>', user) %>
          <% }); %>
        </div>
      </div>
    <% }); %>
    <% if (hasMore) { %>
      <div style="text-align:center;padding:20px">
        <button class="btn" onclick="navigate(event,'/recently-played?offset=<%= (nextOffset || 50) %>')">Load More</button>
      </div>
    <% } %>
  <% } %>
</div>
