<div class="section">
  <div class="section-header">
    <h1>Liked Songs</h1>
    <span class="badge badge-lg"><%= songs.length %> songs</span>
  </div>
  <% const sList = songs.length ? songs.map(s => songItem(s, '', user)).join('') : '<div class="empty-state"><div class="empty-icon">❤️</div><p>No liked songs yet.</p></div>'; %>
  <div class="song-list"><%- sList %></div>
</div>
