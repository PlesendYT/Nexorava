<% const { escapeHtml, fmtDur, fmtDate, GENRES } = helpers; %>
<% const maxPlays = playsTimeSeries && playsTimeSeries.length ? Math.max(...playsTimeSeries.map(d => d.count), 1) : 1; %>
<% const totalPlaysVal = totalPlays || 0; %>
<% const totalSongsVal = totalSongs || 0; %>
<% const playsTodayVal = playsToday || 0; %>
<% const playsWeekVal = playsWeek || 0; %>
<% const playsMonthVal = playsMonth || 0; %>
<% const uniqueListenersVal = uniqueListeners || 0; %>
<% const skipRateVal = skipRate || 0; %>
<% const totalLikesVal = totalLikes || 0; %>
<% const engagementRateVal = engagementRate || (totalPlaysVal > 0 ? ((totalLikesVal / totalPlaysVal) * 100).toFixed(1) : 0); %>
<div class="container">
  <h1>Creator Analytics</h1>
  <p class="text-muted">Your music performance data.</p>

  <div class="analytics-grid">
    <div class="analytics-card" style="border-left:4px solid #1db954">
      <h3>Total Songs</h3>
      <div class="value"><%= totalSongsVal.toLocaleString() %></div>
    </div>
    <div class="analytics-card" style="border-left:4px solid #3498db">
      <h3>Total Plays</h3>
      <div class="value"><%= totalPlaysVal.toLocaleString() %></div>
    </div>
    <div class="analytics-card" style="border-left:4px solid #f39c12">
      <h3>Plays Today</h3>
      <div class="value"><%= playsTodayVal.toLocaleString() %></div>
    </div>
    <div class="analytics-card" style="border-left:4px solid #e67e22">
      <h3>Plays this Week</h3>
      <div class="value"><%= playsWeekVal.toLocaleString() %></div>
    </div>
    <div class="analytics-card" style="border-left:4px solid #9b59b6">
      <h3>Plays this Month</h3>
      <div class="value"><%= playsMonthVal.toLocaleString() %></div>
    </div>
    <div class="analytics-card" style="border-left:4px solid #e74c3c">
      <h3>Unique Listeners</h3>
      <div class="value"><%= uniqueListenersVal.toLocaleString() %></div>
    </div>
    <div class="analytics-card" style="border-left:4px solid #2ecc71">
      <h3>Engagement Rate</h3>
      <div class="value"><%= engagementRateVal %>%</div>
      <div class="sub">Likes per play</div>
    </div>
    <div class="analytics-card" style="border-left:4px solid #e74c3c">
      <h3>Skip Rate</h3>
      <div class="value"><%= Math.round(skipRateVal * 100) %>%</div>
      <div class="sub">Percentage of plays skipped</div>
    </div>
  </div>

  <div class="admin-section">
    <h2>Plays (Last 14 Days)</h2>
    <% if (!playsTimeSeries || playsTimeSeries.length === 0) { %>
      <p class="text-muted">Not enough data yet.</p>
    <% } else { %>
      <div class="bar-chart" style="display:flex;align-items:flex-end;gap:8px;height:180px;padding:10px 0;overflow-x:auto">
        <% playsTimeSeries.forEach(d => { %>
          <div class="bar-item" style="display:flex;flex-direction:column;align-items:center;flex-shrink:0;width:36px">
            <div class="bar" style="width:24px;height:<%= Math.max(3, (d.count / maxPlays) * 150) %>px;background:linear-gradient(to top,var(--accent),#4ade80);border-radius:4px 4px 0 0;transition:height 0.3s" title="<%= d.date %>: <%= d.count %> plays"></div>
            <span class="bar-label" style="font-size:0.65rem;color:var(--text3);margin-top:4px;writing-mode:vertical-lr;text-orientation:mixed"><%= d.date.slice(5) %></span>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>

  <div class="admin-section">
    <h2>Top Songs</h2>
    <% if (!songs || songs.length === 0) { %>
      <p class="text-muted">No songs uploaded yet.</p>
    <% } else { %>
      <% const topSongs = songs.slice().sort((a, b) => (b.plays || 0) - (a.plays || 0)).slice(0, 10); %>
      <table class="admin-table">
        <thead><tr><th>#</th><th>Title</th><th>Duration</th><th>Plays</th><th>Likes</th><th>Skips</th><th>Engagement</th></tr></thead>
        <tbody>
          <% topSongs.forEach((s, i) => { %>
            <tr>
              <td><%= i + 1 %></td>
              <td><a href="/song/<%= s.id %>" style="color:var(--text)"><%= escapeHtml(s.title) %></a></td>
              <td><%= fmtDur(s.duration) %></td>
              <td><%= (s.plays || 0).toLocaleString() %></td>
              <td><%= (s.likeCount || 0).toLocaleString() %></td>
              <td><%= (s.skipCount || 0).toLocaleString() %></td>
              <td><%= totalPlaysVal > 0 ? ((s.likeCount || 0) / Math.max(1, s.plays || 1) * 100).toFixed(1) : 0 %>%</td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </div>

  <div class="admin-section">
    <h2>Follower Growth</h2>
    <% if (!followerGrowth || followerGrowth.length === 0) { %>
      <p class="text-muted">Not enough data yet.</p>
    <% } else { %>
      <% const maxFollow = Math.max(...followerGrowth.map(d => d.count), 1); %>
      <div class="bar-chart" style="display:flex;align-items:flex-end;gap:8px;height:160px;padding:10px 0;overflow-x:auto">
        <% followerGrowth.forEach(d => { %>
          <div class="bar-item" style="display:flex;flex-direction:column;align-items:center;flex-shrink:0;width:32px">
            <div class="bar" style="width:20px;height:<%= Math.max(3, (d.count / maxFollow) * 130) %>px;background:linear-gradient(to top,#e74c3c,#f39c12);border-radius:4px 4px 0 0" title="<%= d.date %>: <%= d.count %> followers"></div>
            <span class="bar-label" style="font-size:0.6rem;color:var(--text3);margin-top:4px"><%= d.date.slice(5) %></span>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>

  <div class="admin-section">
    <h2>Peak Listening Hours</h2>
    <% if (!peakHours || peakHours.length === 0) { %>
      <p class="text-muted">Not enough data yet.</p>
    <% } else { %>
      <% const maxHour = Math.max(...peakHours.map(h => h.count), 1); %>
      <div class="bar-chart" style="display:flex;align-items:flex-end;gap:4px;height:160px;padding:10px 0;overflow-x:auto">
        <% for (let h = 0; h < 24; h++) { %>
          <% const found = peakHours.find(p => p.hour === h); %>
          <% const count = found ? found.count : 0; %>
          <div class="bar-item" style="display:flex;flex-direction:column;align-items:center;flex-shrink:0;width:24px">
            <div class="bar" style="width:16px;height:<%= Math.max(2, (count / maxHour) * 130) %>px;background:linear-gradient(to top,<%= count > 0 ? '#3498db' : 'var(--bg4)' %>,<%= count > 0 ? '#2ecc71' : 'var(--bg4)' %>);border-radius:4px 4px 0 0" title="<%= h %>:00 - <%= count %> plays"></div>
            <span class="bar-label" style="font-size:0.55rem;color:var(--text3);margin-top:4px"><%= h %></span>
          </div>
        <% } %>
      </div>
    <% } %>
  </div>

  <div class="admin-section">
    <h2>Tips Received</h2>
    <% if (!tips || tips.length === 0) { %>
      <p class="text-muted">No tips received yet.</p>
    <% } else { %>
      <table class="admin-table">
        <thead><tr><th>From</th><th>Amount</th><th>Message</th><th>Date</th></tr></thead>
        <tbody>
          <% tips.forEach(t => { %>
            <tr>
              <td><%= escapeHtml(t.from_name || 'Anonymous') %></td>
              <td><%= t.amount %> coins</td>
              <td><%= escapeHtml(t.message || '') %></td>
              <td><%= fmtDate(t.created_at) %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </div>

  <div class="admin-section">
    <h2>All Songs</h2>
    <div style="margin-bottom:12px;display:flex;gap:8px;flex-wrap:wrap">
      <input type="text" id="songFilter" class="filter-input" placeholder="Filter by title..." style="flex:1;min-width:150px" oninput="filterSongs()">
      <select id="genreFilter" class="filter-select" onchange="filterSongs()">
        <option value="">All Genres</option>
        <% GENRES.forEach(g => { %>
          <option value="<%= g %>"><%= g %></option>
        <% }); %>
      </select>
      <select id="sortFilter" class="filter-select" onchange="filterSongs()">
        <option value="plays">Sort: Plays</option>
        <option value="title">Sort: Title</option>
        <option value="date">Sort: Date</option>
        <option value="likes">Sort: Likes</option>
      </select>
    </div>
    <% if (!songs || songs.length === 0) { %>
      <p class="text-muted">No songs uploaded yet.</p>
    <% } else { %>
      <table class="admin-table" id="allSongsTable">
        <thead><tr><th>Title</th><th>Genre</th><th>Duration</th><th>Plays</th><th>Likes</th><th>Skips</th><th>Uploaded</th></tr></thead>
        <tbody>
          <% songs.forEach(s => { %>
            <tr class="song-row" data-title="<%= escapeHtml(s.title).toLowerCase() %>" data-genre="<%= escapeHtml(s.genre || '') %>" data-plays="<%= s.plays || 0 %>" data-likes="<%= s.likeCount || 0 %>" data-date="<%= s.uploaded_at || '' %>">
              <td><a href="/song/<%= s.id %>" style="color:var(--text)"><%= escapeHtml(s.title) %></a></td>
              <td><% if (s.genre) { %><span class="genre-tag"><%= escapeHtml(s.genre) %></span><% } %></td>
              <td><%= fmtDur(s.duration) %></td>
              <td><%= (s.plays || 0).toLocaleString() %></td>
              <td><%= (s.likeCount || 0).toLocaleString() %></td>
              <td><%= (s.skipCount || 0).toLocaleString() %></td>
              <td><%= fmtDate(s.uploaded_at) %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </div>
</div>
<script>
function filterSongs() {
  const q = (document.getElementById('songFilter')?.value || '').toLowerCase();
  const genre = document.getElementById('genreFilter')?.value || '';
  const sort = document.getElementById('sortFilter')?.value || 'plays';
  const rows = document.querySelectorAll('.song-row');
  const visible = [];
  rows.forEach(r => {
    const title = r.dataset.title || '';
    const g = r.dataset.genre || '';
    const match = (!q || title.includes(q)) && (!genre || g === genre);
    r.style.display = match ? '' : 'none';
    if (match) visible.push(r);
  });
  if (sort === 'title') {
    visible.sort((a, b) => (a.dataset.title || '').localeCompare(b.dataset.title || ''));
  } else if (sort === 'plays') {
    visible.sort((a, b) => parseInt(b.dataset.plays || 0) - parseInt(a.dataset.plays || 0));
  } else if (sort === 'likes') {
    visible.sort((a, b) => parseInt(b.dataset.likes || 0) - parseInt(a.dataset.likes || 0));
  } else if (sort === 'date') {
    visible.sort((a, b) => (b.dataset.date || '').localeCompare(a.dataset.date || ''));
  }
  const tbody = document.querySelector('#allSongsTable tbody');
  visible.forEach(r => tbody.appendChild(r));
}
</script>
