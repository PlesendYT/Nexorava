<div class="section">
  <div class="playlist-header">
    <div class="playlist-cover-placeholder">📋</div>
    <div class="playlist-header-info">
      <span class="badge">Playlist</span>
      <h1><%= escapeHtml(playlist.title) %></h1>
      <p class="text-muted">
        by <a href="/artist/<%= escapeHtml(playlist.owner_name) %>" class="artist-link"><%= escapeHtml(playlist.owner_name) %></a>
        <%= playlist.description ? ' · ' + escapeHtml(playlist.description) : '' %>
      </p>
    </div>
  </div>
  <% const sList = songs.length ? songs.map(s => songItem(s, '', user)).join('') : '<div class="empty-state"><p>No songs in this playlist.</p></div>'; %>
  <div class="song-list"><%- sList %></div>
</div>
