<div class="auth-page">
  <div class="auth-card card-glass">
    <h1>Welcome Back</h1>
    <p class="text-muted">Sign in to your account</p>
    <% if (error) { %><div class="alert alert-error"><%= escapeHtml(error) %></div><% } %>
    <form method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-group">
        <input type="text" name="username" required class="form-input" placeholder="Username">
        <label class="form-label">Username</label>
      </div>
      <div class="form-group">
        <input type="password" name="password" required class="form-input" placeholder="Password">
        <label class="form-label">Password</label>
      </div>
      <button type="submit" class="btn btn-primary btn-block">Sign In</button>
    </form>
    <div class="auth-divider"><span>or</span></div>
    <form method="POST" action="/login/guest">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="btn btn-secondary btn-block">Continue as Guest</button>
    </form>
    <p class="auth-link">No account yet? <a href="/register">Create one</a></p>
  </div>
</div>
