<div class="login-container">
  <h1>Login</h1>
  <% if (error) { %><div class="alert alert-error"><%= escapeHtml(error) %></div><% } %>
  <form method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-group"><label>Username</label><input type="text" name="username" required class="form-input"></div>
    <div class="form-group"><label>Password</label><input type="password" name="password" required class="form-input"></div>
    <button type="submit" class="btn btn-primary btn-block">Login</button>
  </form>
  <form method="POST" action="/login/guest">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button type="submit" class="login-guest-btn">Continue as Guest</button>
  </form>
  <p class="auth-link" style="text-align:center;margin-top:12px;">No account yet? <a href="/register">Register</a></p>
</div>