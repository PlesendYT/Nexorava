<div class="section">
  <div class="section-header">
    <h1>Public Playlists</h1>
  </div>
  <div class="mini-grid">
    <% if (playlists.length) { %>
      <% playlists.forEach(p => { %>
      <a href="/playlist/<%= p.id %>" class="mini-card card-glass" style="text-decoration:none;color:inherit">
        <div class="mini-card-icon">📋</div>
        <div class="mini-card-body">
          <strong><%= escapeHtml(p.title) %></strong>
          <small><%= escapeHtml(p.owner_name) %> · <%= p.song_count %> songs</small>
        </div>
      </a>
      <% }) %>
    <% } else { %>
      <div class="empty-state"><p>No public playlists yet.</p></div>
    <% } %>
  </div>
</div>
