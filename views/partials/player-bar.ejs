<div class="player-bar" id="playerBar" style="display:none">
  <div class="player-inner">
    <div class="player-visualizer">
      <canvas id="visualizer" class="visualizer-canvas"></canvas>
    </div>
    <div class="player-info">
      <strong id="playerTitle">Title</strong>
      <span id="playerArtist">Artist</span>
    </div>
    <div class="player-controls">
      <button id="shuffleBtn" class="ctrl-btn" title="Shuffle Off" style="opacity:0.6">&#128257;</button>
      <button id="prevBtn" class="ctrl-btn">&#9198;</button>
      <button id="playBtn" class="ctrl-btn ctrl-play">&#9654;</button>
      <button id="nextBtn" class="ctrl-btn">&#9197;</button>
      <button id="repeatBtn" class="ctrl-btn" title="No Repeat" style="opacity:0.6">&#128257;</button>
    </div>
    <div class="player-progress">
      <span id="currentTime">0:00</span>
      <input type="range" id="progressBar" value="0" max="100">
      <span id="totalTime">0:00</span>
    </div>
    <div class="player-volume">
      <span>&#128266;</span>
      <input type="range" id="volumeBar" min="0" max="1" step="0.05" value="0.7">
    </div>
    <div class="player-extra-controls">
      <button id="queueBtn" class="ctrl-btn" title="Queue">&#9776;</button>
    </div>
    <div class="player-quality">
      <% if (user && user.premium) { %><span class="premium-dot">&#11088;</span><% } %>
      <select id="qualitySelect">
        <% Object.keys(config.streaming).filter(k => allowedQualities.includes(k)).forEach(k => { %>
          <option value="<%= k %>" <%= streamQuality === k ? 'selected' : '' %>><%= config.streaming[k].label %></option>
        <% }) %>
      </select>
    </div>
  </div>
</div>
